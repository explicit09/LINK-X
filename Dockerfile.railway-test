# Test Dockerfile for Railway - includes dependencies but runs minimal app
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install
COPY docker-image/src/requirements.txt .
RUN pip install --no-cache-dir flask==3.0.0 gunicorn==21.2.0 python-dotenv==1.0.0

# Copy the minimal test app and full source (for later)
COPY docker-image/src/app_minimal.py ./
COPY docker-image/src/ ./src/

# Create necessary directories
RUN mkdir -p logs data

ENV PYTHONPATH=/app/src:$PYTHONPATH
ENV PYTHONUNBUFFERED=1

# Start with minimal app
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "1", "--timeout", "30", "--log-level", "debug", "app_minimal:app"]