# Use the official slim Python image
FROM python:3.10-slim

# Allow statements and log messages to immediately appear in the Knative logs
ENV PYTHONUNBUFFERED=True
ENV PYTHONPATH="/app:/app/src"

# Set the application home directory
ENV APP_HOME=/app
WORKDIR $APP_HOME

# Install system dependencies first (cached layer)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements files first for better caching
COPY config/base.txt config/prod.txt ./

# Install Python dependencies (this layer is cached if requirements don't change)
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r prod.txt

# Copy migration script
COPY run_migrations.sh /run_migrations.sh
RUN chmod +x /run_migrations.sh

# Copy application files last (changes frequently)
COPY src/.env ./
COPY src/firebaseKey.json ./
COPY src/prompts.py ./
COPY src/textUtils.py ./
COPY src/indexer.py ./
COPY src/transcriber.py ./
COPY src $APP_HOME/src

# Environment variables for Flask
ENV MODULE=src.wsgi
ENV QT_X11_NO_MITSHM=1
ENV PORT=8080
EXPOSE 8080

# Set the entry point to run migrations and then start the app
ENTRYPOINT ["/run_migrations.sh"]
CMD ["gunicorn", "--bind", ":8080", "--workers", "1", "--threads", "8", "--timeout", "0", "src.wsgi:app"]