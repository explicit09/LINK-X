# Multi-stage Dockerfile for production LINK-X
# Stage 1: Build dependencies and application
FROM python:3.11-slim as builder

# Install system dependencies for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install requirements
COPY src/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/requirements.txt

# Stage 2: Runtime image
FROM python:3.11-slim as runtime

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user
RUN groupadd -r linkx && useradd -r -g linkx -d /app -s /bin/bash linkx

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy application code with proper ownership
COPY --chown=linkx:linkx src/ ./src/
COPY --chown=linkx:linkx docker/entrypoint.sh ./entrypoint.sh

# Create necessary directories with proper permissions
RUN mkdir -p logs uploads temp \
    && chown -R linkx:linkx /app \
    && chmod +x entrypoint.sh

# Security: Set secure file permissions
RUN find /app -type f -exec chmod 644 {} \; \
    && find /app -type d -exec chmod 755 {} \; \
    && chmod +x entrypoint.sh

# Switch to non-root user
USER linkx

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV FLASK_APP=src.app:create_app
ENV PORT=8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/api/health || exit 1

EXPOSE ${PORT}

# Use the entrypoint script
ENTRYPOINT ["./entrypoint.sh"]
CMD ["gunicorn", "--config", "python:src.core.gunicorn_config", "src.app:create_app()"] 