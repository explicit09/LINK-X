# Development Dockerfile with hot-reload and debugging support
FROM python:3.11-slim

# Install system dependencies and development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    python3-dev \
    libmagic1 \
    git \
    vim \
    curl \
    make \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables for development
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/app:/app/src" \
    FLASK_ENV=development \
    FLASK_DEBUG=1 \
    PIP_NO_CACHE_DIR=1

# Create app directory
WORKDIR /app

# Install Python dependencies
COPY config/base.txt config/dev.txt ./config/
RUN pip install --upgrade pip wheel setuptools && \
    pip install --no-cache-dir -r config/dev.txt && \
    # Install additional dev tools
    pip install --no-cache-dir \
        ipdb \
        flask-shell-ipython \
        watchdog[watchmedo] \
        pytest-watch

# Copy application source (will be overridden by volume mount)
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY docker/entrypoint.sh ./
COPY docker/celery-entrypoint.sh ./docker/

# Make scripts executable
RUN chmod +x entrypoint.sh docker/celery-entrypoint.sh scripts/**/*.py

# Create necessary directories
RUN mkdir -p logs uploads temp

# Install pre-commit hooks for development (if config exists)
# Note: .pre-commit-config.yaml is optional
RUN git init . || true

# Expose ports
EXPOSE 8080
# Debugger port
EXPOSE 5678
# Streamlit port (if using)
EXPOSE 8501

# Development entrypoint with hot-reload
ENTRYPOINT ["/app/entrypoint.sh"]

# Use Flask development server with reloader
CMD ["python", "-m", "flask", "run", \
     "--host=0.0.0.0", \
     "--port=8080", \
     "--reload", \
     "--debugger", \
     "--with-threads"]