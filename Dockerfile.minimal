# Ultra-minimal Dockerfile for Railway initial deployment
FROM python:3.11-slim

WORKDIR /app

# Copy and install only core dependencies
RUN pip install --no-cache-dir \
    flask==3.0.0 \
    gunicorn==21.2.0

# Copy minimal app
COPY docker-image/src/app_minimal.py ./

ENV PYTHONUNBUFFERED=1

# EXPOSE the port
EXPOSE 8000

# Simple startup
CMD gunicorn --bind 0.0.0.0:${PORT:-8000} --workers 1 --timeout 60 app_minimal:app