# Environment Variables for LINK-X Workers on Railway
# Copy this to your Railway environment variables for each worker service

# === DATABASE CONNECTION ===
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === REDIS CONNECTION (REQUIRED FOR CELERY WORKERS) ===
# Get this from Railway Redis service → Connect → Copy URL
REDIS_URL=redis://your-redis-host:6379/0

# === API KEYS ===
OPENAI_API_KEY=sk-your-openai-api-key

# === WORKER CONFIGURATION ===
# Embedding Worker Settings (for embedding worker only)
WORKER_ID=railway-embedding-worker-${RAILWAY_REPLICA_ID}
EMBEDDING_BATCH_SIZE=50
POLL_INTERVAL=2.0
EMBEDDING_MODEL=text-embedding-3-small

# Celery Worker Settings (for celery workers only)
CELERY_WORKER_CONCURRENCY=2
CELERY_MAX_TASKS_PER_CHILD=1000

# === MEMORY OPTIMIZATION ===
PYTHONMALLOC=malloc
MALLOC_ARENA_MAX=2

# === LOGGING ===
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# === MONITORING ===
WORKER_HEALTH_CHECK_INTERVAL=60
METRICS_INTERVAL=300

# === FEATURE FLAGS ===
EMBEDDINGS_ENABLED=true
FILE_PROCESSING_ENABLED=true
MAINTENANCE_TASKS_ENABLED=true 