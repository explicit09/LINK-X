{
  "name": "learnx-celery-beat",
  "source": {
    "repo": "https://github.com/explicit09/LINK-X.git",
    "branch": "main"
  },
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "/app/docker/celery-entrypoint.sh beat",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "numReplicas": 1
  },
  "envVars": {
    "FLASK_ENV": "production",
    "SERVICE_NAME": "celery-beat",
    "C_FORCE_ROOT": "1"
  },
  "notes": "Only one instance should run to avoid duplicate scheduled tasks"
}