# Simplified Dockerfile for Railway - optimized for speed
FROM python:3.11-slim

# Install only essential runtime dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY docker-image/src/requirements.txt .

# Install Python dependencies (remove heavy packages for initial deploy)
RUN pip install --no-cache-dir \
    flask==3.0.0 \
    flask-cors==4.0.0 \
    flask-limiter==3.5.0 \
    SQLAlchemy==2.0.23 \
    psycopg2-binary==2.9.9 \
    python-dotenv==1.0.0 \
    PyJWT==2.8.0 \
    gunicorn==21.2.0 \
    redis==5.0.1 \
    celery==5.3.4 \
    requests==2.31.0 \
    openai==1.6.1 \
    boto3==1.34.11 \
    firebase-admin==6.3.0

# Copy application code
COPY docker-image/src/ ./src/

# Create necessary directories
RUN mkdir -p logs data/uploads data/cache

# Environment setup
ENV PYTHONPATH=/app/src:$PYTHONPATH
ENV PYTHONUNBUFFERED=1

# Use Railway's PORT environment variable
CMD gunicorn --bind 0.0.0.0:$PORT --workers 2 --timeout 120 --chdir src app:app