# Railway-specific Dockerfile without cache mounts
ARG PYTHON_VERSION=3.11

# Build stage
FROM python:${PYTHON_VERSION}-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only requirements first for better caching
COPY docker-image/src/requirements.txt .

# Install Python dependencies
RUN pip install --prefix=/usr/local -r requirements.txt

# Runtime stage
FROM python:${PYTHON_VERSION}-slim

# Install runtime dependencies including psycopg2 and bc for the startup script
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    bc \
    && rm -rf /var/lib/apt/lists/*

# Install psycopg2-binary for database connectivity testing
RUN pip install psycopg2-binary

# Create non-root user with home directory
RUN groupadd -r linkx && useradd -r -g linkx -d /home/linkx -m linkx

WORKDIR /app

# Copy Python dependencies from builder
COPY --from=builder /usr/local /usr/local

# Copy application code with proper ownership
COPY --chown=linkx:linkx docker-image/src/ ./src/
COPY --chown=linkx:linkx docker-image/docker/ ./docker/

# Set permissions and create necessary directories
RUN chmod +x /app/docker/*.sh && \
    mkdir -p /app/logs /app/data /tmp/gunicorn && \
    chown -R linkx:linkx /app

# Environment setup
ENV PATH=/usr/local/bin:$PATH \
    PYTHONPATH=/app/src:$PYTHONPATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    GUNICORN_WORKER_CLASS=sync \
    GUNICORN_MAX_REQUESTS=1000 \
    GUNICORN_MAX_REQUESTS_JITTER=100 \
    GUNICORN_PRELOAD_APP=true

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -s http://localhost:8000/api/v2/health | grep -q "status" || exit 1

USER linkx
EXPOSE 8000

# Use the Railway startup script for optimized deployment
CMD ["/app/docker/railway-startup.sh"]