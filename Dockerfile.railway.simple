# Simple Railway Dockerfile - Direct Gunicorn startup
ARG PYTHON_VERSION=3.11

# Build stage
FROM python:${PYTHON_VERSION}-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only requirements first for better caching
COPY docker-image/src/requirements.txt .

# Install Python dependencies
RUN pip install --prefix=/usr/local -r requirements.txt

# Runtime stage
FROM python:${PYTHON_VERSION}-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r linkx && useradd -r -g linkx linkx

WORKDIR /app

# Copy Python dependencies from builder
COPY --from=builder /usr/local /usr/local

# Copy application code
COPY --chown=linkx:linkx docker-image/src/ ./src/

# Set basic environment variables for Railway optimization
ENV PYTHONPATH=/app/src:$PYTHONPATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONMALLOC=malloc \
    MALLOC_ARENA_MAX=2

# Health check using PORT variable
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -s http://localhost:${PORT:-8000}/api/v2/health || exit 1

USER linkx
EXPOSE ${PORT:-8000}

# Direct Gunicorn command with Railway PORT support
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-8000} --workers 2 --worker-class sync --timeout 120 --keep-alive 2 --max-requests 1000 --max-requests-jitter 100 --preload --access-logfile - --error-logfile - --log-level info --chdir /app/src 'app:create_app()'"] 