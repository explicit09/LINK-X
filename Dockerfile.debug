# Debug Dockerfile for Railway
FROM python:3.11-slim

# Install minimal dependencies
RUN pip install flask==3.0.0 gunicorn==21.2.0

WORKDIR /app

# Copy debug app
COPY docker-image/src/app_debug.py ./

# Print debug info during build
RUN echo "Build complete" && ls -la

# Use PORT from environment or default to 8000
ENV PORT=8000
ENV PYTHONUNBUFFERED=1

# EXPOSE the port
EXPOSE 8000

# Start with verbose logging
CMD ["python", "-u", "app_debug.py"]