# LEARN-X Frontend Environment Configuration
# Copy this file to .env.local and replace with your actual values

# ===== REQUIRED VARIABLES =====

# Supabase Configuration (Public Keys Only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== OPTIONAL VARIABLES =====

# Feature Flags (if implementing)
# NEXT_PUBLIC_ENABLE_GAMIFICATION=true
# NEXT_PUBLIC_ENABLE_COLLABORATION=true

# Analytics (if using)
# NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key

# ===== DEPRECATED - DO NOT USE =====
# The following variables are no longer used:
# - All NEXT_PUBLIC_FIREBASE_* variables (migrated to Supabase)
# - NEXT_PUBLIC_S3_* variables (migrated to Supabase Storage)