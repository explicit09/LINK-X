# Vercel Environment Variables for LINK-X Frontend
# Set these in your Vercel Dashboard → Project Settings → Environment Variables

# === BACKEND API ===
# Your Railway backend URL (from Railway dashboard)
NEXT_PUBLIC_API_URL=https://your-railway-app.railway.app

# === SUPABASE CONFIGURATION ===
# From Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# === SITE CONFIGURATION ===
# Your Vercel domain(s) - comma separated
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app,https://your-custom-domain.com

# === API VERSION ===
NEXT_PUBLIC_API_VERSION=v2

# === FEATURE FLAGS ===
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_COLLABORATION=true

# === BUILD CONFIGURATION ===
# Optional: Asset prefix for CDN
ASSET_PREFIX=

# Optional: Build optimizations
NODE_ENV=production 