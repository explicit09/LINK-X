# Vercel Environment Variables for LINK-X Frontend
# Set these in your Vercel Dashboard → Project Settings → Environment Variables

# === BACKEND API ===
# Your Railway backend URL (from Railway dashboard)
NEXT_PUBLIC_API_URL=https://your-railway-app.railway.app

# === SUPABASE CONFIGURATION ===
# From Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# === API VERSION ===
NEXT_PUBLIC_API_VERSION=v2

# === FEATURE FLAGS ===
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_COLLABORATION=true

# === CUSTOM DOMAIN (OPTIONAL) ===
# Only set this if you have a custom domain
# If not set, Vercel's VERCEL_URL will be used automatically
# NEXT_PUBLIC_SITE_URL=https://your-custom-domain.com

# === BUILD CONFIGURATION ===
# Optional: Build optimizations
NODE_ENV=production 